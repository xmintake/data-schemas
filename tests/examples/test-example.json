{
  "$schema": "https://xmintake.github.io/data-schemas/meta/xmintake-scenario-schema.v1.json",
  "metadata": {
    "createdAt": "2026-03-12T10:00:00Z",
    "createdBy": "QA Team",
    "testName": "Namespace and Form Full Cycle Test",
    "description": "Tests creation of namespace, schemas, destination, setting fields, and form submission.",
    "environment": "debug"
  },
  "test": [
    {
      "id": "step1",
      "description": "Navigate to home screen",
      "action": "navigate",
      "appLink": "https://xmintake.xmarin.dev/home"
    },
    {
      "id": "step2",
      "description": "Create namespace 'Backlog'",
      "action": "createNamespace",
      "appLink": "https://xmintake.xmarin.dev/ns/create?namespace=Backlog",
      "assertions": [
        {
          "type": "exists",
          "target": "namespace:Backlog",
          "expected": true
        }
      ]
    },
    {
      "id": "step3",
      "description": "Add schema S_1 to Backlog namespace",
      "action": "addSchema",
      "appLink": "https://xmintake.xmarin.dev/ns/add-schema?namespace=Backlog&schemaUrl=https://github.com/xmintake/data-schemas/backlog/S_1.json",
      "assertions": [
        {
          "type": "exists",
          "target": "namespace:Backlog/schema:S_1",
          "expected": true
        }
      ]
    },
    {
      "id": "step4",
      "description": "Add destination D_1 to Backlog namespace",
      "action": "addDestination",
      "appLink": "https://xmintake.xmarin.dev/ns/add-destination?namespace=Backlog&destinationName=D_1&sheetId=abc123&gid=0",
      "assertions": [
        {
          "type": "exists",
          "target": "namespace:Backlog/destination:D_1",
          "expected": true
        }
      ]
    },
    {
      "id": "step5",
      "description": "Pre-fill fields in S_1 form",
      "action": "setFields",
      "appLink": "https://xmintake.xmarin.dev/f/set-fields?destination=D_1&fields=name=Joe%20Doe,phone=88812349876",
      "assertions": [
        {
          "type": "valueEquals",
          "target": "field:name",
          "expected": "Joe Doe"
        },
        {
          "type": "valueEquals",
          "target": "field:phone",
          "expected": "88812349876"
        }
      ]
    },
    {
      "id": "step6",
      "description": "Submit form",
      "action": "submitForm",
      "appLink": "https://xmintake.xmarin.dev/f/submit?destination=D_1",
      "assertions": [
        {
          "type": "rowCountEquals",
          "target": "sheet:abc123",
          "expected": 1
        }
      ]
    }
  ]
}
